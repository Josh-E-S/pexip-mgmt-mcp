{
  "mcpServers": {
    "pexip-mgmt": {
      "command": "uv",
      "args": [
        "--directory",
        "${PEXIP_MCP_DIR:-../pexip-mgmt-mcp}",
        "run",
        "python",
        "-m",
        "pexip_mcp"
      ],
      "env": {
        "PEXIP_HOST": "${PEXIP_HOST}",
        "PEXIP_USERNAME": "${PEXIP_USERNAME}",
        "PEXIP_PASSWORD": "${PEXIP_PASSWORD}",
        "PEXIP_VERIFY_TLS": "${PEXIP_VERIFY_TLS:-true}",
        "PEXIP_TIMEOUT": "${PEXIP_TIMEOUT:-30}",
        "PEXIP_MAX_RETRIES": "${PEXIP_MAX_RETRIES:-3}",
        "PEXIP_AUTH_MODE": "${PEXIP_AUTH_MODE:-basic}",
        "PEXIP_OAUTH2_CLIENT_ID": "${PEXIP_OAUTH2_CLIENT_ID:-}",
        "PEXIP_OAUTH2_PRIVATE_KEY": "${PEXIP_OAUTH2_PRIVATE_KEY:-}",
        "PEXIP_READ_ONLY": "${PEXIP_READ_ONLY:-true}",
        "PEXIP_ALLOW_SECURITY_RESOURCES": "${PEXIP_ALLOW_SECURITY_RESOURCES:-false}",
        "PEXIP_ALLOW_PLATFORM_TOOLS": "${PEXIP_ALLOW_PLATFORM_TOOLS:-false}"
      }
    }
  }
}
